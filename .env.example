# FormFlow Environment Configuration Example
APP_NAME=FormFlow
APP_TITLE=FormFlow: Intelligent PDF Form Field Extraction Pipeline
APP_ENV=development
DEBUG=False

# Storage & Database
DATABASE_PATH=data/formflow.db
MAX_FILE_SIZE_MB=25
MAX_PAGES_LIMIT=50

# OCR Engine Settings
# Set this explicitly if Tesseract is not in PATH or Program Files
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_DPI=200
SCANNED_PAGE_CHAR_THRESHOLD=45
